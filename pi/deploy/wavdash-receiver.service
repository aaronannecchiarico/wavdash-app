[Unit]
Description=WavDash Stem Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aannecchiarico
WorkingDirectory=/home/aannecchiarico/wavdash/receiver
Environment=WAVDASH_STEMS_DIR=/home/aannecchiarico/wavdash-stems
ExecStart=/home/aannecchiarico/env/bin/uvicorn main:app --host 0.0.0.0 --port 9000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
