# Flake8 Configuration
# Code quality and style checking

[flake8]
# Match CI/CD configuration
max-line-length = 127
max-complexity = 10

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    beatforge-audio-extraction-service-local,
    venv,
    env,
    build,
    dist,
    .eggs,
    *.egg-info,
    .tox,
    .pytest_cache,
    .mypy_cache,
    node_modules,
    migrations

# Error codes to check
# The CI runs two passes:
# Pass 1: Critical errors only (E9,F63,F7,F82)
# Pass 2: All errors with max-complexity and max-line-length
# For local development, we check all errors
# Uncomment the line below to only check critical errors like CI pass 1:
# select = E9,F63,F7,F82

# Ignore certain errors (common in FastAPI/async code)
ignore =
    # W503: line break before binary operator (conflicts with Black)
    W503,
    # E203: whitespace before ':' (conflicts with Black)
    E203,
    # E501: line too long (handled by Black, max 127 in second pass)
    # E501,
    # E402: module level import not at top of file (sometimes needed)
    # E402,

# Show source code for each error
show-source = True

# Show statistics at the end
statistics = True

# Count the number of occurrences of each error/warning code
count = True

# Enable specific warning categories
enable-extensions =
    # G: logging format
    # G001: Logging '.format()' string formatting
    # G002: Logging statement uses '%'
    # G003: Logging statement uses '+'
    # G004: Logging statement uses f-string

# Per-file ignores (if needed)
per-file-ignores =
    # __init__.py files can have unused imports
    __init__.py:F401,F403
    # Test files can have unused imports and longer lines
    tests/*:F401,E501
    # Config files might have unused imports
    config.py:F401

# Docstring conventions (optional - enable if you want docstring checks)
# docstring-convention = google

# Naming conventions
# These match PEP 8 by default, uncomment to enforce stricter rules
# ignore-names = setUp,tearDown,setUpClass,tearDownClass
