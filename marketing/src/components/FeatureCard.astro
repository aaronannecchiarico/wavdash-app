---
import { Icon } from './react/Icon';

interface Props {
  title: string;
  description: string;
  features: string[];
  iconName: string;
  color?: string;
}

const { title, description, features, iconName } = Astro.props;
---

<div class="studio-card p-8 h-full flex flex-col">
  <div class="w-10 h-10 rounded-[--radius-md] bg-[--amber]/10 flex items-center justify-center mb-6">
    <Icon name={iconName} size={20} className="text-[--amber]" client:load />
  </div>

  <h3 class="font-sans font-semibold text-base text-foreground mb-3">
    {title}
  </h3>

  <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
    {description}
  </p>

  <ul class="space-y-2 mt-auto">
    {features.map((feature) => (
      <li class="flex items-start gap-2 text-sm text-muted-foreground">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 mt-0.5 text-[--jade]" stroke="currentColor" stroke-width="2">
          <path d="M2 7l3.5 3.5L12 3.5"/>
        </svg>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
</div>
