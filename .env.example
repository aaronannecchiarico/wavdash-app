# WavDash Monorepo Environment Configuration
# Copy this to .env and configure for your environment

# =============================================================================
# Container Runtime
# =============================================================================
# This project uses Colima for container runtime
# Install: brew install colima docker docker-compose
# Start: colima start

# =============================================================================
# Database Configuration
# =============================================================================
# Local development uses SQLite (no configuration needed)
# Docker/Production uses MySQL (configured below)

# MySQL (Docker/Production only)
DB_DATABASE=wavdash
DB_USERNAME=wavdash
DB_PASSWORD=secret

# =============================================================================
# Service Configuration
# =============================================================================
# These environment variables are used by docker-compose

# Shared environment
COMPOSE_PROJECT_NAME=wavdash

# Laravel App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Marketing Site
MARKETING_URL=http://localhost:4321

# Audio Service
AUDIO_SERVICE_URL=http://audio-api:8000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Development Tools
# =============================================================================
# Mail testing (Docker only)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@wavdash.local
MAIL_FROM_NAME=WavDash

# =============================================================================
# Storage Configuration
# =============================================================================
# Storage Mode: r2 (Cloudflare R2) or local (shared Docker volume)
# Recommended: r2 for Docker (production-like), local for offline development
STORAGE_MODE=r2

# Cloudflare R2 Credentials (shared by Laravel app and audio service)
# IMPORTANT: Replace with your actual R2 credentials
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 Buckets
# Private bucket: uploads, processed files, stems (access-controlled)
R2_PRIVATE_BUCKET=audio-private
# Public bucket: streaming files (publicly accessible)
R2_PUBLIC_BUCKET=audio-public
R2_PUBLIC_URL=https://your-public-bucket.r2.dev

# Shared Storage Path (for local mode only)
# When STORAGE_MODE=local, containers share this Docker volume
SHARED_STORAGE_PATH=/app/shared-storage

# =============================================================================
# Laravel Reverb (WebSockets) — Production Docker only
# =============================================================================
# These are used by docker-compose.yml for the app-reverb service.
# For local dev, Reverb credentials come from app/.env directly.
# Copy your values from app/.env:
REVERB_APP_ID=your_reverb_app_id
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret

## Pi
# STEM Device URL (for audio service to communicate with the stem device)
STEM_DEVICE_URL=http://100.xx.xx.xx:port

# =============================================================================
# Individual Service .env Files
# =============================================================================
# Each service needs its own .env file:
# - app/.env (Laravel configuration)
# - audio-service/.env (Python/FastAPI configuration)
# - marketing/.env (Astro configuration)
#
# For Docker: R2 credentials are injected from this root .env automatically
# For local development: Copy R2 credentials to each service's .env file
#
# See respective .env.example files in each directory
# See R2_STORAGE_STRATEGY.md for detailed storage configuration guide


