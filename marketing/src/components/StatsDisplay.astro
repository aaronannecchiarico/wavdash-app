---
interface Props {
  value: string;
  label: string;
  iconName?: string;
  color?: string;
}

const { value, label } = Astro.props;
---

<div class="text-center">
  <div class="font-mono text-5xl md:text-6xl font-medium text-[--amber] mb-2">
    {value}
  </div>
  <div class="text-sm font-medium text-muted-foreground">
    {label}
  </div>
</div>
