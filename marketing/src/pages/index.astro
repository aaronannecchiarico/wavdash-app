---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from '../components/react/Icon';
import FeatureCard from '../components/FeatureCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import StatsDisplay from '../components/StatsDisplay.astro';
import TechBadge from '../components/TechBadge.astro';
import { AudioAnalysisDemo } from '../components/react/AudioAnalysisDemo';
import { OrbWithFallback } from '../components/react/OrbWithFallback';
import { AnimatedSection } from '../components/react/AnimatedSection';
import { checkAuthStatus } from '../lib/auth';

// Disable prerendering to enable server-side rendering with access to request headers
export const prerender = false;

// Check authentication status for conditional rendering
const { authenticated: isLoggedIn } = await checkAuthStatus(Astro.request);

const appUrl = import.meta.env.PUBLIC_APP_URL || 'http://localhost:8000';
---

<MainLayout
  title="WavDash — Precision Audio Intelligence for Serious Producers"
  description="Professional stem separation, BPM analysis, and audio processing for producers who demand precision. Free to use. No credit card required."
  ogTitle="WavDash — Precision Audio Intelligence"
  ogDescription="Professional audio analysis and stem separation for serious producers."
>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center px-6 md:px-12 py-32 overflow-hidden">
    <!-- Gradient mesh background -->
    <div class="gradient-mesh absolute inset-0 pointer-events-none"></div>
    <!-- Subtle grain overlay -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.025]"
         style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22/><feColorMatrix type=%22saturate%22 values=%220%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/></svg>'); background-repeat: repeat; background-size: 128px 128px;">
    </div>

    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <!-- Brand mark -->
      <div class="inline-flex h-14 w-14 rounded-full bg-[--amber] items-center justify-center mb-10 shadow-amber mx-auto">
        <Icon name="Music" size={24} className="text-foreground" client:load />
      </div>

      <!-- Main headline -->
      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl text-foreground mb-6" style="letter-spacing: -0.025em; line-height: 1.1;">
        Precision audio<br/>intelligence.
      </h1>

      <!-- Subheadline -->
      <p class="text-lg md:text-xl text-muted-foreground mb-10 max-w-xl mx-auto leading-relaxed">
        Professional stem separation, BPM analysis, and audio processing for producers who demand precision.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        {isLoggedIn ? (
          <a
            href={`${appUrl}/dashboard`}
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-[--radius-md] bg-primary text-primary-foreground font-medium text-sm shadow-amber hover:scale-[1.01] transition-all"
          >
            Go to Dashboard
          </a>
        ) : (
          <>
            <a
              href={`${appUrl}/register`}
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-[--radius-md] bg-primary text-primary-foreground font-medium text-sm shadow-amber hover:scale-[1.01] transition-all"
            >
              Get started free
            </a>
            <a
              href="#demo"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-[--radius-md] border border-[--border-strong] bg-transparent text-foreground font-medium text-sm hover:bg-muted transition-all"
            >
              See it in action
            </a>
          </>
        )}
      </div>

      <!-- Scroll indicator -->
      <div class="mt-16 flex flex-col items-center gap-2 text-muted-foreground">
        <span class="text-xs font-medium tracking-wide uppercase">Scroll to explore</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="animate-bounce">
          <path d="M8 3v10M3 9l5 5 5-5"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="px-6 md:px-12 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-serif text-3xl md:text-4xl text-foreground mb-4">What WavDash does</h2>
        <p class="text-base text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Every tool a serious producer needs to understand, deconstruct, and transform audio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <AnimatedSection delay={0} client:visible>
          <FeatureCard
            iconName="BarChart3"
            title="Instant audio analysis"
            description="Deep analysis of your track's DNA — BPM, key, loudness, dynamics, and timbral character in seconds."
            features={[
              'BPM detection and tempo analysis',
              'Musical key identification with confidence scoring',
              'Loudness and dynamic range measurements',
              'Timbral complexity and brightness analysis',
              'Detailed waveform visualization',
            ]}
          />
        </AnimatedSection>

        <AnimatedSection delay={0.1} client:visible>
          <FeatureCard
            iconName="Scissors"
            title="Professional stem separation"
            description="AI-powered source separation that isolates vocals, drums, bass, and more with studio-grade precision."
            features={[
              'AI-powered stem extraction (vocals, drums, bass, other)',
              'High-quality separation algorithms',
              'Download individual stems for remixing',
              'Real-time processing with live updates via WebSockets',
              'Perfect for producers and remixers',
            ]}
          />
        </AnimatedSection>

        <AnimatedSection delay={0.2} client:visible>
          <FeatureCard
            iconName="Gauge"
            title="Tempo and pitch processing"
            description="Stretch, shift, and transform your audio without compromising quality. Full control over time and pitch."
            features={[
              'Nightcore and sped-up variations',
              'Slowed + reverb effects',
              'Maintain audio quality during tempo changes',
              'Multiple preset options available',
              'Preserve or modify pitch independently',
            ]}
          />
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="px-6 md:px-12 py-24 bg-[--surface-2]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-serif text-3xl md:text-4xl text-foreground mb-4">How it works</h2>
        <p class="text-base text-muted-foreground max-w-xl mx-auto leading-relaxed">
          From upload to insight in seconds. No configuration, no complexity.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <AnimatedSection delay={0} client:visible>
          <ProcessStep
            stepNumber={1}
            title="Upload your track"
            description="Drag and drop or browse to select. We support MP3, WAV, FLAC, OGG, and more. Processing begins immediately."
            iconName="Upload"
            showArrow={true}
          />
        </AnimatedSection>

        <AnimatedSection delay={0.1} client:visible>
          <ProcessStep
            stepNumber={2}
            title="AI analysis runs"
            description="Watch real-time updates as AI analyzes your track — BPM, stems, key, and more processed in parallel."
            iconName="Cpu"
            showArrow={true}
          />
        </AnimatedSection>

        <AnimatedSection delay={0.2} client:visible>
          <ProcessStep
            stepNumber={3}
            title="Download your results"
            description="Get processed stems, analysis data, or tempo variants. Everything stored securely and ready to download."
            iconName="Download"
          />
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Demo Section -->
  <section id="demo" class="relative px-6 md:px-12 py-24 overflow-hidden" style="background: linear-gradient(180deg, var(--surface-2) 0%, var(--background) 40%, var(--surface-2) 100%);">
    <!-- Radial depth gradient behind the panel -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 50% 55%, rgba(0,0,0,0.04) 0%, transparent 70%);"></div>

    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-5 text-xs font-mono tracking-widest uppercase" style="background: rgba(200,137,42,0.08); border: 1px solid rgba(200,137,42,0.18); color: var(--amber);">
          <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: currentColor; animation: pulse 2s infinite;"></span>
          Live demo — interactive
        </div>
        <h2 class="font-serif text-3xl md:text-4xl text-foreground mb-4">See the analysis in action</h2>
        <p class="text-base text-muted-foreground max-w-md mx-auto leading-relaxed">
          A real snapshot of what WavDash surfaces from every track — instantly.
        </p>
      </div>

      <AnimatedSection delay={0} client:visible>
        <AudioAnalysisDemo client:visible />
      </AnimatedSection>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="px-6 md:px-12 py-24 bg-[--surface-2]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-serif text-3xl text-foreground mb-4">Trusted by creators worldwide</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <AnimatedSection delay={0} client:visible>
          <StatsDisplay value="10,000+" label="Tracks processed" />
        </AnimatedSection>
        <AnimatedSection delay={0.15} client:visible>
          <StatsDisplay value="5,000+" label="Active producers" />
        </AnimatedSection>
        <AnimatedSection delay={0.3} client:visible>
          <StatsDisplay value="100%" label="Free to use" />
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section class="px-6 md:px-12 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-serif text-3xl md:text-4xl text-foreground mb-4">Built on production-grade infrastructure</h2>
        <p class="text-base text-muted-foreground max-w-xl mx-auto leading-relaxed">
          Enterprise-grade tools powering your creative workflow.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <TechBadge
          iconName="Radio"
          title="Real-time updates"
          description="WebSockets via Laravel Reverb for live processing status"
        />
        <TechBadge
          iconName="Zap"
          title="Client-side processing"
          description="MediaBunny library for instant audio conversion"
        />
        <TechBadge
          iconName="Cloud"
          title="Cloud storage"
          description="Cloudflare R2 integration for reliable, fast file storage"
        />
        <TechBadge
          iconName="Music"
          title="High-quality processing"
          description="FFmpeg and Demucs-powered audio analysis and separation"
        />
        <TechBadge
          iconName="Shield"
          title="Secure and private"
          description="Your audio files are encrypted and never shared"
        />
        <TechBadge
          iconName="Server"
          title="Modern stack"
          description="Laravel 12, React 19, Inertia.js, TypeScript, Tailwind v4"
        />
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="px-6 md:px-12 py-24 bg-[--surface-2]">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-foreground mb-4">Simple, free pricing</h2>
        <p class="text-base text-muted-foreground leading-relaxed">
          No credit card required. No hidden fees. Just professional audio tools.
        </p>
      </div>

      <div class="studio-card p-10 md:p-12">
        <div class="text-center mb-8 pb-8 border-b border-[--border]">
          <div class="inline-flex h-10 w-10 rounded-full bg-[--amber]/10 items-center justify-center mb-4">
            <Icon name="Music" size={18} className="text-[--amber]" client:load />
          </div>
          <h3 class="font-sans font-semibold text-lg text-foreground mb-1">Free tier</h3>
          <div class="font-mono text-5xl font-medium text-foreground mt-3">$0</div>
          <p class="text-sm text-muted-foreground mt-2">Forever free</p>
        </div>

        <ul class="space-y-4 mb-10">
          {[
            'No credit card required',
            'Unlimited uploads and processing',
            'Full access to all audio analysis features',
            'Stem separation and tempo processing',
            'Participate in contests',
            'Cloud storage for your files',
          ].map((feature) => (
            <li class="flex items-start gap-3 text-sm text-foreground">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-0.5 text-[--jade]" stroke="currentColor" stroke-width="2">
                <path d="M2.5 8l3.5 3.5 7-7"/>
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <div class="text-center">
          <a
            href={`${appUrl}/register`}
            class="inline-flex items-center justify-center w-full px-8 py-3.5 rounded-[--radius-md] bg-primary text-primary-foreground font-medium text-sm shadow-amber hover:scale-[1.01] transition-all"
          >
            Get started free
          </a>
        </div>

        <p class="text-center text-xs text-muted-foreground mt-6">
          Premium features coming soon — early adopters get lifetime benefits
        </p>
      </div>
    </div>
  </section>

  <!-- Community / Contests Section -->
  <section class="px-6 md:px-12 py-24">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex h-12 w-12 rounded-full bg-[--amber]/10 items-center justify-center mb-6">
        <Icon name="Trophy" size={20} className="text-[--amber]" client:load />
      </div>
      <h2 class="font-serif text-3xl md:text-4xl text-foreground mb-5">Join the community</h2>
      <p class="text-base text-muted-foreground mb-8 leading-relaxed max-w-xl mx-auto">
        Participate in music creation challenges, community-driven competitions, and showcase your work to fellow producers.
      </p>
      <a
        href={`${appUrl}/contests`}
        class="inline-flex items-center justify-center px-7 py-3.5 rounded-[--radius-md] border border-[--border-strong] bg-transparent text-foreground font-medium text-sm hover:bg-muted transition-all"
      >
        Explore contests
      </a>
    </div>
  </section>

  <!-- Footer CTA Section -->
  <section class="relative py-28 px-6 md:px-12 overflow-hidden">
    <div class="gradient-mesh absolute inset-0 pointer-events-none"></div>
    <div class="relative z-10 text-center max-w-2xl mx-auto">
      <h2 class="font-serif text-4xl md:text-5xl text-foreground mb-6" style="line-height: 1.1;">
        Ready to hear your music differently?
      </h2>
      <p class="text-lg text-muted-foreground mb-10 leading-relaxed">
        Upload your first track and get instant analysis, stems, and tempo insights.
      </p>
      <a
        href={`${appUrl}/register`}
        class="inline-flex items-center justify-center px-8 py-4 rounded-[--radius-md] bg-primary text-primary-foreground font-medium text-base shadow-amber hover:scale-[1.01] transition-all"
      >
        Get started free
      </a>
      <p class="mt-5 text-sm text-muted-foreground">No credit card required • Process your first track in minutes</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-[--border] py-12 px-6 md:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between gap-10">
        <!-- Brand -->
        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[--amber] shrink-0">
              <Icon name="Music" size={14} className="text-foreground" client:load />
            </div>
            <span class="font-sans font-semibold text-base text-foreground">WavDash</span>
          </div>
          <p class="text-sm text-muted-foreground max-w-xs leading-relaxed">
            Professional audio analysis and stem separation for serious producers.
          </p>
        </div>

        <!-- Nav columns -->
        <div class="flex gap-12">
          <div>
            <h4 class="font-sans font-semibold text-xs text-foreground uppercase tracking-wide mb-4">Product</h4>
            <nav class="space-y-2.5">
              <a href="#features" class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Features</a>
              <a href="#how-it-works" class="block text-sm text-muted-foreground hover:text-foreground transition-colors">How it works</a>
              <a href="#pricing" class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Pricing</a>
            </nav>
          </div>
          <div>
            <h4 class="font-sans font-semibold text-xs text-foreground uppercase tracking-wide mb-4">Account</h4>
            <nav class="space-y-2.5">
              <a href={`${appUrl}/login`} class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Sign in</a>
              <a href={`${appUrl}/register`} class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Create account</a>
              <a href={`${appUrl}/contests`} class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Contests</a>
            </nav>
          </div>
        </div>
      </div>

      <div class="mt-10 pt-6 border-t border-[--border] flex flex-col md:flex-row justify-between items-center gap-3">
        <p class="text-sm text-muted-foreground">© 2025 WavDash. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy</a>
          <a href="#" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms</a>
        </div>
      </div>
    </div>
  </footer>
</MainLayout>
