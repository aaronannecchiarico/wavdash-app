# Audio Processing Microservice Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Redis Configuration  
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Device Configuration (auto detects best available: mps, cuda, cpu)
DEMUCS_DEVICE=auto

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Audio Processing
SAMPLE_RATE=22050
MAX_FILE_SIZE=104857600
SUPPORTED_FORMATS=wav,mp3,flac,m4a,ogg

# Feature Extraction Settings  
HOP_LENGTH=512
N_MELS=128
N_MFCC=13

# AI Model Configuration
DEMUCS_MODEL=htdemucs

# File Storage
TEMP_DIR=/tmp/audio_processing
# Note: Output files now go to configured storage (LOCAL_STORAGE_PATH or R2)

# Task Configuration
TASK_TIME_LIMIT=1800
TASK_SOFT_TIME_LIMIT=1500

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Storage Configuration
# Options: local, r2
STORAGE_TYPE=local

# Local Storage Configuration (when STORAGE_TYPE=local)
# Should match Laravel's storage path: /path/to/laravel/storage/app/private
LOCAL_STORAGE_PATH=/usr/path/to/wavdash/storage/app/private
LOCAL_STORAGE_PUBLIC_URL=

# Cloudflare R2 Storage Configuration (when STORAGE_TYPE=r2)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=forge-audio
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://forge-audio.your-account-id.r2.dev