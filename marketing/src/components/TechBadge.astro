---
import { Icon } from './react/Icon';

interface Props {
  iconName: string;
  title: string;
  description: string;
}

const { iconName, title, description } = Astro.props;
---

<div class="studio-card px-6 py-5 flex items-start gap-4">
  <div class="w-9 h-9 rounded-[--radius-md] bg-[--amber]/10 flex items-center justify-center shrink-0">
    <Icon name={iconName} size={18} className="text-[--amber]" client:load />
  </div>
  <div>
    <p class="font-sans font-semibold text-sm text-foreground mb-1">{title}</p>
    <p class="text-xs text-muted-foreground leading-relaxed">{description}</p>
  </div>
</div>
